{
  "manifest_version": 3,
  "name": "Dailies",
  "version": "1.0.0",
  "description": "Download YouTube videos to your Dailies server in the format you pick, using the YouTube sign-in you already have in Chrome.",
  "permissions": ["cookies", "storage", "alarms", "contextMenus"],
  "host_permissions": ["https://*.youtube.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Dailies", "default_icon": { "128": "icon.png" } },
  "options_page": "options.html",
  "icons": { "128": "icon.png" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["ui.js", "content.js"], "run_at": "document_idle" }
  ]
}
